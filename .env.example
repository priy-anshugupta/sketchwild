# Local open vision model. Download it separately before using live feedback.
AI_PROVIDER=ollama
AI_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT_MS=300000
AI_IMAGE_MAX_EDGE=640
PORT=3001
HOST=127.0.0.1
# For Render: HOST=0.0.0.0 and choose a hosted open-weight vision endpoint.
# AI_PROVIDER=hosted
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=your-secret
# AI_MODEL=exact-open-vision-model-id
# AI_TIMEOUT_MS=45000
# AI_IMAGE_MAX_EDGE=1280
# Check your selected provider's retention policy before filling this in.
# AI_RETENTION_NOTICE=Describe the provider's policy here.
# Daily cap includes failed upstream attempts. Resets on app restart.
AI_DAILY_REQUEST_LIMIT=100
